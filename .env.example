# Copy this file to .env and fill in real values there.
# .env itself is git-ignored and never gets committed — this file is just the template.

# Groq API key — free, get one at https://console.groq.com (Milestone 3)
GROQ_API_KEY=your-groq-api-key-here

# LangSmith tracing — optional until Milestone 8
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=finsolve-rag-rbac

# Qdrant Cloud — free cluster at https://cloud.qdrant.io (Milestone 14)
QDRANT_URL=your-qdrant-cluster-url-here
QDRANT_API_KEY=your-qdrant-api-key-here
